# ============================================================
# AI Lead Automation System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to git
# ============================================================

# ---- n8n Core Settings ----
# Generate a strong random key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your-32-char-random-encryption-key-here

# Host settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Set this to your public URL if deploying to a server
# Example: WEBHOOK_URL=https://n8n.yourcompany.com/
WEBHOOK_URL=http://localhost:5678/

# Timezone (use TZ database name)
GENERIC_TIMEZONE=UTC

# Log level: error, warn, info, verbose, debug
N8N_LOG_LEVEL=info

# ---- n8n Basic Auth (optional, enable for production) ----
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123!

# ---- API Keys (configure these in n8n credentials UI, not here) ----
# These are for reference only — add them inside n8n's credential manager

# Gemini API Key — get from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# Slack Incoming Webhook URL — get from https://api.slack.com/apps
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Google Sheets Spreadsheet ID (from the URL of your sheet)
# GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Gmail sender address
# GMAIL_FROM=your-email@gmail.com
