      "id": "a1b2c3d4-0001-0001-0001-a1b2c3d40001",
      "name": "Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "b2c3d4e5-0001-0001-0001-b2c3d4e50001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $credentials.queryAuth.value }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a lead qualification expert for a B2B company.\\nAnalyze this lead and respond ONLY in raw JSON with absolutely no markdown, no code blocks, no extra text.\\nResponse must start with { and end with }\\n\\nReturn exactly this structure:\\n{\\n  \\\"score\\\": <number 1-10>,\\n  \\\"quality\\\": \\\"<Hot or Warm or Cold>\\\",\\n  \\\"reason\\\": \\\"<one sentence max>\\\",\\n  \\\"reply_tone\\\": \\\"<urgent or normal or low_priority>\\\"\\n}\\n\\nScoring rules:\\n- Hot (8-10): Clear budget, specific need, decision maker\\n- Warm (5-7): Interested but vague, needs nurturing\\n- Cold (1-4): No budget, just browsing, student\\n\\nLead details:\\nName: {{ $('Receive Lead').item.json.body.name }}\\nCompany: {{ $('Receive Lead').item.json.body.company }}\\nMessage: {{ $('Receive Lead').item.json.body.message }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 512\n  }\n}",
        "options": {}
      },
      "id": "c3d4e5f6-0002-0002-0002-c3d4e5f60002",
      "name": "Analyze Lead with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "credentials": {
        "httpQueryAuth": {
          "id": "GEMINI-CREDENTIAL-ID",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Parse Gemini AI response and build clean lead object\nconst geminiResponse = $input.first().json;\nconst webhookBody = $('Receive Lead').first().json.body;\n\n// Extract AI text from Gemini candidates\nlet rawText = '';\ntry {\n  rawText = geminiResponse.candidates[0].content.parts[0].text;\n} catch (e) {\n  throw new Error('Gemini response structure unexpected: ' + JSON.stringify(geminiResponse));\n}\n\n// Strip any markdown code blocks if present (defensive)\nconst cleanText = rawText\n  .trim()\n  .replace(/```json\\s*/g, '')\n  .replace(/```\\s*/g, '')\n  .trim();\n\n// Parse the JSON response\nlet aiAnalysis;\ntry {\n  aiAnalysis = JSON.parse(cleanText);\n} catch (e) {\n  throw new Error('Failed to parse Gemini JSON: ' + cleanText);\n}\n\n// Validate required fields\nconst requiredFields = ['score', 'quality', 'reason', 'reply_tone'];\nfor (const field of requiredFields) {\n  if (!(field in aiAnalysis)) {\n    throw new Error(`Missing field '${field}' in Gemini response: ${cleanText}`);\n  }\n}\n\n// Build structured lead object\nconst now = new Date();\nconst timestamp = now.toISOString();\n\nreturn [\n  {\n    json: {\n      timestamp,\n      name: webhookBody.name || '',\n      email: webhookBody.email || '',\n      company: webhookBody.company || '',\n      message: webhookBody.message || '',\n      leadScore: aiAnalysis.score,\n      leadQuality: aiAnalysis.quality,\n      aiReason: aiAnalysis.reason,\n      replyTone: aiAnalysis.reply_tone,\n      emailSent: 'Yes',\n      slackNotified: 'Yes'\n    }\n  }\n];"
      },
      "id": "d4e5f6a7-0003-0003-0003-d4e5f6a70003",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}",
            "Message": "={{ $json.message }}",
            "Lead Score": "={{ $json.leadScore }}",
            "Lead Quality": "={{ $json.leadQuality }}",
            "AI Reason": "={{ $json.aiReason }}",
            "Reply Tone": "={{ $json.replyTone }}",
            "Email Sent": "={{ $json.emailSent }}",
            "Slack Notified": "={{ $json.slackNotified }}"
          }
        },
        "options": {}
      },
